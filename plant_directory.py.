plants = {
    "neem": {
        "scientific_name": "Azadirachta indica",
        "family": "Meliaceae"
    },
    "mango": {
        "scientific_name": "Mangifera indica",
        "family": "Anacardiaceae"
    },
    "sunflower": {
        "scientific_name": "Helianthus annuus",
        "family": "Asteraceae"
    }
}

name = input("Enter a plant name: ").lower().strip()

if name in plants:
    print("Scientific name:", plants[name]["scientific_name"])
    print("Family:", plants[name]["family"])
else:
    print("Plant not found!")
