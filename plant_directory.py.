import json
from pathlib import Path

BASE_DIR = Path(__file__).resolve().parent
DATA_FILE = BASE_DIR / "plants.json"

DEFAULT_PLANTS = {
    "neem": {
        "scientific_name": "Azadirachta indica",
        "family": "Meliaceae"
    },
    "mango": {
        "scientific_name": "Mangifera indica",
        "family": "Anacardiaceae"
    },
    "sunflower": {
        "scientific_name": "Helianthus annuus",
        "family": "Asteraceae"
    }
}


def load_plants():
    if not DATA_FILE.exists():
        return DEFAULT_PLANTS.copy()

    try:
        with DATA_FILE.open("r", encoding="utf-8") as file:
            data = json.load(file)

        if isinstance(data, dict):
            return data

        print("Saved data has an unexpected format. Using defaults.")
    except (json.JSONDecodeError, OSError) as error:
        print("Could not load saved plants:", error)

    return DEFAULT_PLANTS.copy()


def save_plants(plants):
    with DATA_FILE.open("w", encoding="utf-8") as file:
        json.dump(plants, file, indent=4, ensure_ascii=False)


def search_plant(plants):
    name = input("Enter plant name: ").strip().lower()
    plant = plants.get(name)

    if plant:
        print("Scientific name:", plant["scientific_name"])
        print("Family:", plant["family"])
    else:
        print("Plant not found!")


def show_plants(plants):
    if not plants:
        print("No plants in the directory yet.")
        return

    for name, details in sorted(plants.items()):
        print("\nPlant:", name.title())
        print("Scientific name:", details["scientific_name"])
        print("Family:", details["family"])


def add_plant(plants):
    name = input("Common plant name: ").strip().lower()
    scientific_name = input("Scientific name: ").strip()
    family = input("Plant family: ").strip()

    if not name or not scientific_name or not family:
        print("Please fill in all three fields.")
        return

    if name in plants:
        print("This plant already exists.")
        return

    plants[name] = {
        "scientific_name": scientific_name,
        "family": family
    }

    try:
        save_plants(plants)
        print("Plant added and saved successfully!")
    except OSError as error:
        del plants[name]
        print("Could not save the plant:", error)


def main():
    plants = load_plants()

    while True:
        print("\n=== Plant Directory Utility ===")
        print("1. Search for a plant")
        print("2. Show all plants")
        print("3. Add a new plant")
        print("4. Exit")

        choice = input("Choose 1, 2, 3, or 4: ").strip()

        if choice == "1":
            search_plant(plants)
        elif choice == "2":
            show_plants(plants)
        elif choice == "3":
            add_plant(plants)
        elif choice == "4":
            print("Thank you for using Plant Directory Utility!")
            break
        else:
            print("Invalid choice. Please enter 1, 2, 3, or 4.")


if __name__ == "__main__":
    main()

