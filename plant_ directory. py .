# Simple plant database using Python dictionaries
plant_database = {
    "rose": {
        "scientific_name": "Rosa rubiginosa",
        "family": "Rosaceae",
        "watering": "Moderate"
    },
    "tulip": {
        "scientific_name": "Tulipa gesneriana",
        "family": "Liliaceae",
        "watering": "Low"
    },
    "tomato": {
        "scientific_name": "Solanum lycopersicum",
        "family": "Solanaceae",
        "watering": "High"
    }
}

def search_plant(name):
    name = name.lower()
    if name in plant_database:
        details = plant_database[name]
        print(f"\n--- Results for: {name.capitalize()} ---")
        print(f"Scientific Name: {details['scientific_name']}")
        print(f"Family: {details['family']}")
        print(f"Watering Need: {details['watering']}")
    else:
        print(f"\nSorry, '{name}' is not in the database yet.")

if __name__ == "__main__":
    print("Welcome to the Plant Directory Utility!")
    user_query = input("Enter a plant name to search (e.g., Rose, Tomato): ")
    search_plant(user_query)
